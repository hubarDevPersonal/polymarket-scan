# ── Go Arbitrage Engine ─────────────────────────────────────────
# HTTP server listen address
HTTP_ADDR=:8080

# Minimum edge return-on-risk percentage to flag an opportunity
EDGE_MIN_ROR_PCT=3.0

# Title similarity threshold for matching markets across platforms
TITLE_SIM=0.60

# Time window in hours for event matching
TIME_WINDOW_H=168

# Polymarket chunk size for market fetching
PM_CHUNK=400

# Kalshi API credentials (required for Kalshi market data)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
